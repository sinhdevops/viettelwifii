# No real credentials in this file.
# Public website origin used by links, display hostname, canonical and sitemap.
# NEXT_PUBLIC_ values are bundled at build time: rebuild after changing this URL.
NEXT_PUBLIC_SITE_URL=https://viettelwifii.vn
NEXT_PUBLIC_PHONE_NUMBER=0325610016
NEXT_PUBLIC_ZALO_URL=
# Publication is ungated: SITE_LIVE and the four approval flags were removed.
PRIVACY_POLICY_VERSION=v1
# Forms are enabled by default; no LEAD_CAPTURE_ENABLED switch is needed.
SITE_CONTACT_EMAIL=
# Google Ads conversion tracking (gtag.js). Leave NEXT_PUBLIC_GOOGLE_ADS_ID empty to
# load no Google tag at all. Rebuild after changing these values.
# ID format: AW-123456789. Labels: the part after "/" in the conversion's send_to.
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Conversion fired after the lead API confirms a form submission (with Enhanced
# Conversions phone data, hashed by gtag.js in the browser).
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
# Conversion fired on a click of the hotline tel: link or a Zalo link.
NEXT_PUBLIC_GOOGLE_ADS_CONTACT_LABEL=
# Run db/001_create_leads.sql, then db/002_lead_privacy_rls.sql in Supabase.
# Keep the secret key server-side. Submitting requires these storage credentials; the form stays visible.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Telegram is sent after the saved lead is confirmed to the browser. Missing credentials leave its notification status failed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Run db/003_lead_installation_guard_notify.sql for address columns, rate limit and duplicate guard.
# "next" (default): this app sends Telegram. "supabase": the lead-telegram Edge Function
# sends it (db/004_lead_telegram_webhook.sql); set only after that is deployed.
LEAD_NOTIFY_MODE=next
# Optional HMAC salt for IP rate-limit buckets; defaults to the Supabase secret.
LEAD_RATE_LIMIT_SALT=

# No real credentials in this file.
# Public website origin used by links, display hostname, canonical and sitemap.
# NEXT_PUBLIC_ values are bundled at build time: rebuild after changing this URL.
NEXT_PUBLIC_SITE_URL=https://viettelwifii.vn
NEXT_PUBLIC_PHONE_NUMBER=0325610016
NEXT_PUBLIC_ZALO_URL=
# Publication is ungated: SITE_LIVE and the four approval flags were removed.
PRIVACY_POLICY_VERSION=v1
# Forms are enabled by default; no LEAD_CAPTURE_ENABLED switch is needed.
SITE_CONTACT_EMAIL=
# Analytics delivery is not enabled; dataLayer events remain local only.
# Run db/001_create_leads.sql, then db/002_lead_privacy_rls.sql in Supabase.
# Keep the secret key server-side. Submitting requires these storage credentials; the form stays visible.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Telegram is sent after the saved lead is confirmed to the browser. Missing credentials leave its notification status failed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

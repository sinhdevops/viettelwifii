# No real credentials in this file.
# Public website origin used by links, display hostname, canonical and sitemap.
# NEXT_PUBLIC_ values are bundled at build time: rebuild after changing this URL.
NEXT_PUBLIC_SITE_URL=https://viettelwifii.vn
SITE_LIVE=false
NEXT_PUBLIC_PHONE_NUMBER=0325610016
NEXT_PUBLIC_ZALO_URL=
# Only enable GTM after the site's consent/tracking requirements are met.
NEXT_PUBLIC_GTM_ID=
# Run db/001_create_leads.sql in the Supabase SQL editor before accepting leads.
# Keep the secret key server-side. Without both values the lead API returns 503.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Telegram is sent after the lead is saved. Missing credentials leave the lead saved as failed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Production requires BOTH Turnstile keys; mismatched keys return 503.
# Keep the secret server-side. Do not place real credentials in this file.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

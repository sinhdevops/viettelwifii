{
  "name": "viettelup-next-core",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run routes:check && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --configLoader runner",
    "test:e2e": "playwright test",
    "routes:check": "node scripts/verify-route-scope.mjs",
    "routes:audit": "node scripts/generate-clone-checklist.mjs",
    "prepare": "node scripts/prepare-husky.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.0",
    "@lottiefiles/dotlottie-web": "0.58.1",
    "@marsidev/react-turnstile": "^1.1.0",
    "@next/third-parties": "^16.4.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.1",
    "nextjs-toploader": "^3.9.17",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.60.0",
    "sonner": "^2.0.0",
    "swiper": "^14.3.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  }
}
